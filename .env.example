# ---------------------------------------------------------------------
# Optional. Medical Memory AI works without these — greetings and record
# questions use the deterministic engine. Set these to connect Open WebUI,
# Ollama, or any OpenAI-compatible provider for natural conversation.
#
# Copy to `.env.local` and edit. Nothing here is required to build, test
# or run the application.
# ---------------------------------------------------------------------

# Which wire protocol the endpoint speaks.
#   openai      Ollama, vLLM, LM Studio, llama.cpp, most hosted providers
#   open-webui  Open WebUI (https://github.com/open-webui/open-webui)
# VITE_LLM_PROTOCOL=open-webui

# Where the model is, from the browser's point of view.
#
# `/llm` is this app's own origin, forwarded by the dev server to
# http://localhost:11434. That is the default and needs no CORS setup.
# Point it at an absolute URL only if the endpoint already allows this
# origin.
# VITE_LLM_BASE_URL=/llm

# Which model to ask for.
# VITE_LLM_MODEL=llama3.2

# Bearer token, for an endpoint behind a proxy that wants one. The
# adapter sends `Authorization: Bearer <key>`.
# VITE_LLM_API_KEY=

# How long to wait before giving up and falling back to the engine.
# VITE_LLM_TIMEOUT_MS=60000
