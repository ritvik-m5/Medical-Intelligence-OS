{
  "name": "medical-memory",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.1.0",
  "type": "module",
  "description": "Medical Memory — a personal health digital twin. Temporal Health Graph + provenance + contradiction engine.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --testTimeout=60000",
    "test:watch": "vitest",
    "dev:model": "node scripts/mock-model.mjs 11434",
    "verify:versions": "vite-node scripts/verify.mts versions",
    "verify:rules": "vite-node scripts/verify.mts rules",
    "verify:artifacts": "vite-node scripts/verify.mts artifacts",
    "verify:reproducibility": "vite-node scripts/verify.mts reproducibility",
    "verify": "npm run verify:versions && npm run verify:rules && npm run verify:artifacts && npm run verify:reproducibility",
    "verify:pipeline": "npm run typecheck && npm test && npm run verify && npm run audit:meaning && npm run audit:ai-validation",
    "audit:nav": "node scripts/audit-nav.mjs",
    "audit:meaning": "node scripts/audit-meaning.mjs",
    "audit:ai-gateway": "node scripts/audit-ai-gateway.mjs",
    "audit:ai-validation": "node scripts/audit-ai-validation.mjs",
    "create:file": "node scripts/create-sample-records.mjs",
    "create:records": "node scripts/create-sample-records.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.4"
  }
}
